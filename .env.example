AZURE_OPENAI_EMBEDDING_API_VERSION=2024-02-01

# Azure OpenAI chat/model verification scripts.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_API_VERSION=2025-03-01-preview
AZURE_OPENAI_4_1_MODELS_ENDPOINT=
AZURE_OPENAI_4_1_MODELS_KEY=
AZURE_OPENAI_4_1_MODELS_VERSION=2025-03-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-5.4-mini
AZURE_OPENAI_REASONING_EFFORT=low
AZURE_OPENAI_TIMEOUT=30

# Optional Postgres + pgvector target.
DATABASE_URL=

# Optional website/content fetcher.
